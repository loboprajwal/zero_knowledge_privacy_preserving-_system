<?xml version="1.0" encoding="utf-8"?>
<!-- A vault's ciphertext cannot be restored safely without its Android
     Keystore key, which is bound to the original installation/device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
